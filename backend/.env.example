# ─── Server ───
PORT=4000
NODE_ENV=development

# ─── Database (Docker Compose: port 3307 — xem docker-compose.yml ở root) ───
DATABASE_URL="mysql://perfume:perfume@localhost:3307/perfume_shop"
DATABASE_URL_TEST="mysql://perfume:perfume@localhost:3307/perfume_shop_test"
SHADOW_DATABASE_URL="mysql://perfume:perfume@localhost:3307/perfume_shop_shadow"

# ─── JWT ───
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS ───
# Nhiều origin cách nhau bằng dấu phẩy; `*` khớp 1 nhãn host (preview Vercel):
# CORS_ORIGIN=https://perfume-shop.vercel.app,https://perfume-shop-*-<team>.vercel.app
CORS_ORIGIN=http://localhost:5173

# ─── Business config ───
LOW_STOCK_THRESHOLD=5
REPORT_TIMEZONE_OFFSET=7
DEFAULT_SHIPPING_FEE=30000

# ─── File storage (OD-5: local trước, cloudinary sau — không sửa code module) ───
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Multi-model agent (server-only; never expose these values to frontend) ───
# Set both key and model for each provider you want the orchestrator to use.
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_MODEL=
AGENT_ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=
AGENT_GEMINI_API_KEY=
AGENT_GEMINI_MODEL=

# ─── Seed ───
SEED_PASSWORD=
