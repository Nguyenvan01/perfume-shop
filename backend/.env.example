# ─── Server ───
PORT=4000
NODE_ENV=development

# ─── Database: PostgreSQL ───
# Local (docker compose ở root, port 5434). Không có pooler nên DIRECT_URL = DATABASE_URL.
DATABASE_URL="postgresql://perfume:perfume@localhost:5434/perfume_shop"
DIRECT_URL="postgresql://perfume:perfume@localhost:5434/perfume_shop"
# DB cho `npm test` / `npm run db:migrate:test`. DIRECT_URL_TEST tuỳ chọn (mặc định = DATABASE_URL_TEST).
DATABASE_URL_TEST="postgresql://perfume:perfume@localhost:5434/perfume_shop_test"
# DIRECT_URL_TEST=
#
# Supabase (production) — Project Settings → Database → Connection string:
#   DATABASE_URL = pooler transaction mode (port 6543), bắt buộc ?pgbouncer=true&connection_limit=1 cho serverless
#   DIRECT_URL   = session mode / direct (port 5432) — Prisma Migrate dùng URL này
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── JWT ───
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS ───
CORS_ORIGIN=http://localhost:5173

# ─── Business config ───
LOW_STOCK_THRESHOLD=5
REPORT_TIMEZONE_OFFSET=7
DEFAULT_SHIPPING_FEE=30000

# ─── File storage (OD-5: local trước, cloudinary sau — không sửa code module) ───
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Multi-model agent (server-only; never expose these values to frontend) ───
# Set both key and model for each provider you want the orchestrator to use.
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_MODEL=
AGENT_ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=
AGENT_GEMINI_API_KEY=
AGENT_GEMINI_MODEL=

# ─── Seed ───
SEED_PASSWORD=
